[Unit]
Description=dokumenty82 lead form receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=d82lead
Group=d82lead
EnvironmentFile=/etc/dokumenty82-form.env
ExecStartPre=+/bin/sh -c 'test ! -e /var/lib/dokumenty82-leads/amo-oauth-token.json || /usr/bin/chown d82lead:d82lead /var/lib/dokumenty82-leads/amo-oauth-token.json'
ExecStartPre=+/bin/sh -c 'test ! -e /var/lib/dokumenty82-leads/amo-oauth-token.json || /usr/bin/chmod 600 /var/lib/dokumenty82-leads/amo-oauth-token.json'
ExecStart=/usr/bin/python3 /opt/dokumenty82-form/lead_receiver.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dokumenty82-leads

[Install]
WantedBy=multi-user.target
