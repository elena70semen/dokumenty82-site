D82_PORTAL_HOST=127.0.0.1
D82_PORTAL_PORT=8098
D82_PORTAL_DATA_DIR=/var/lib/dokumenty82-portal
D82_PORTAL_DB_PATH=/var/lib/dokumenty82-portal/portal.db
D82_PORTAL_FILES_DIR=/var/lib/dokumenty82-portal/files
D82_PORTAL_PUBLIC_ORIGIN=https://dokumenty82.ru
D82_PORTAL_DEV_MODE=0
D82_PORTAL_SECURE_COOKIE=1
D82_PORTAL_TRUST_PROXY=1

# Generate at least 32 random bytes. Never commit the production value.
D82_PORTAL_HASH_KEY=

D82_PORTAL_SESSION_TTL_SECONDS=28800
D82_PORTAL_OTP_TTL_SECONDS=600
D82_PORTAL_OTP_MAX_ATTEMPTS=5
D82_PORTAL_OTP_RATE_WINDOW_SECONDS=3600
D82_PORTAL_OTP_RATE_MAX=5
D82_PORTAL_MAX_UPLOAD_MB=10

# Read-only amoCRM snapshot is fetched through the local lead service. The
# OAuth token remains owned by dokumenty82-lead and is never exposed here.
D82_PORTAL_AMO_BRIDGE_URL=http://127.0.0.1:8097/api/internal/amo/client
D82_PORTAL_AMO_BRIDGE_TOKEN=
D82_PORTAL_AMO_SYNC_TTL_SECONDS=300

# Passwordless login email delivery.
D82_PORTAL_SMTP_HOST=
D82_PORTAL_SMTP_PORT=465
D82_PORTAL_SMTP_USERNAME=
D82_PORTAL_SMTP_PASSWORD=
D82_PORTAL_SMTP_FROM=
D82_PORTAL_SMTP_USE_SSL=1
D82_PORTAL_SMTP_STARTTLS=0
